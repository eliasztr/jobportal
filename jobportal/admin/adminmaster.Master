<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="adminmaster.master.cs" Inherits="jobportal.admin.adminmaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title>Admin Area - Job Portal</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="../assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../assets/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="../assets/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">


    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <style>
        /* Sidebar Styling */
        .sidebar {
            width: 250px;
            background: #6a0dad;
            color: white;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 60px;
        }
        .sidebar a {
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: 0.3s;
        }
        .sidebar a:hover {
            background: #500a8b;
        }
        .sidebar i {
            margin-right: 10px;
        }

        /* Navbar */
        .navbar {
            background: #6a0dad;
            color: white;
        }

        /* Main Content */
        .main-content {
            margin-left: 260px;
            padding: 20px;
        }
    </style>
</head>


<body>
    <form id="form1" runat="server">
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark">
            <a class="navbar-brand text-white ml-3" href="Dashboard.aspx">Online Job Portal</a>
            <div class="ml-auto mr-3">
                <asp:Button ID="btnLogout" runat="server" CssClass="btn btn-danger" Text="Logout" OnClientClick="return confirmLogout();" OnClick="btnLogout_Click" />
            </div>
        </nav>

        <!-- Sidebar -->
        <div class="sidebar">
            <a href="dashboard.aspx"><i class="fas fa-home"></i> Dashboard</a>
            <a href="newjob.aspx"><i class="fas fa-briefcase"></i> New Job</a>
            <a href="joblist.aspx"><i class="fas fa-list"></i> Job List</a>
            <a href="viewresume.aspx"><i class="fas fa-file-alt"></i> View Resume</a>
            <a href="contactlist.aspx"><i class="fas fa-envelope"></i> Contact List</a>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>

    <script>
        // Logout Confirmation
        function confirmLogout() {
            return confirm("Are you sure you want to log out?");
        }
    </script>
</body>
</html>
